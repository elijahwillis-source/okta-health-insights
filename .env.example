# Copy to .env for local runs ONLY. In production, set these in your deploy tool's
# environment-variable / secrets store. Never commit real values.

# --- Okta (required) ---------------------------------------------------------
OKTA_ORG_URL=https://your-org.okta.com

# Option A: API token (simplest). Create it under a custom admin role limited to
# read access on System Log + Applications, not a Super Admin.
OKTA_API_TOKEN=

# Option B: OAuth 2.0 service app (private_key_jwt). Leave OKTA_API_TOKEN empty to use it.
# Grant scopes okta.logs.read and okta.apps.read. Multi-line PEMs can be stored with literal \n.
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=
OKTA_KEY_ID=
# OKTA_SCOPES=okta.logs.read okta.apps.read

# --- AI assistant (optional; assistant is disabled without it) ---------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Access control (optional; skip if your platform already puts SSO in front) -
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# --- Tuning (all optional) ----------------------------------------------------
# PORT=8080
# POLL_INTERVAL_SECONDS=60
# LOOKBACK_DAYS=7
# MAX_EVENTS=100000
# MAX_PAGES_PER_POLL=50
# APPS_REFRESH_MINUTES=15
# Narrow the System Log feed on very large orgs (SCIM filter syntax), e.g.:
# OKTA_LOG_FILTER=eventType sw "application." or eventType eq "user.authentication.sso"

# --- Google Workspace OAuth audit (optional; read only) ---
# A service account key limited to https://www.googleapis.com/auth/admin.reports.audit.readonly with domain-wide
# delegation, acting as a dedicated admin that has only the Reports privilege. See README, "Google Workspace OAuth".
# GOOGLE_SA_KEY=            # the JSON key file's contents, or the same text base64-encoded
# GOOGLE_ADMIN_EMAIL=audit-reader@yourdomain.com
# GOOGLE_LOOKBACK_DAYS=30   # at most 180 (Google keeps 6 months)
# GOOGLE_POLL_SECONDS=300
