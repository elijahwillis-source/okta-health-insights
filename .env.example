# Copy to .env for local runs ONLY. In production, set these in your deploy tool's
# environment-variable / secrets store. Never commit real values.

# --- Okta (required) ---------------------------------------------------------
OKTA_ORG_URL=https://your-org.okta.com

# Option A: API token (simplest). Create it under a custom admin role limited to
# read access on System Log + Applications, not a Super Admin.
OKTA_API_TOKEN=

# Option B: OAuth 2.0 service app (private_key_jwt). Leave OKTA_API_TOKEN empty to use it.
# Grant scopes okta.logs.read and okta.apps.read. Multi-line PEMs can be stored with literal \n.
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=
OKTA_KEY_ID=
# OKTA_SCOPES=okta.logs.read okta.apps.read

# --- AI assistant (optional; assistant is disabled without it) ---------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Access control (optional; skip if your platform already puts SSO in front) -
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# --- Tuning (all optional) ----------------------------------------------------
# PORT=8080
# POLL_INTERVAL_SECONDS=60
# Most requests a minute Sightline may send to Okta (an API token gets 50% of an endpoint's limit by default). Lower it if the token is shared.
# OKTA_MAX_RPM=30
# Shared policy (known-error rules, Google app decisions, audit log). In Coolify add a Persistent Storage volume at /app/data.
# DATA_DIR=/app/data
# ---- Single sign-on with Okta (all five are needed; leave them all out to keep the password/open behaviour) ----
# OIDC_ISSUER=https://yourco.okta.com            # or https://yourco.okta.com/oauth2/default for a custom authorization server
# OIDC_CLIENT_ID=0oa...
# OIDC_CLIENT_SECRET=...                         # secret: never commit it
# PUBLIC_URL=https://sightline.example.com       # the address people use, https; the redirect URI is PUBLIC_URL/callback
# SESSION_SECRET=...                             # 32+ random characters: openssl rand -base64 48
# Roles come from Okta groups (case-insensitive, comma separated):
# OIDC_OWNER_GROUPS=sightline-owners
# OIDC_ADMIN_GROUPS=sightline-admins
# OIDC_USER_GROUPS=sightline-users               # leave empty to let anyone Okta lets in be a user
# OIDC_REQUIRE_GROUP=false                       # true: with no user group set, only owners/admins get in
# OWNER_EMAILS=you@example.com                   # optional bootstrap owners, before the groups are set up
# SESSION_HOURS=12   SESSION_IDLE_MINUTES=60
# REQUIRE_SSO=true                              # refuse to serve anything unless sign-in is fully configured (never fall back to open access)
# ASSISTANT_MIN_ROLE=user                        # user | admin | owner: who may use the assistant
# AUDIT_STDOUT=true                              # also print every audit event to the container log as "AUDIT {json}"
# Only behind a sign-in proxy that sets this header to the person's email (makes audit names verified):
# USER_HEADER=X-Forwarded-Email
# POLICY_ADMINS=alice@example.com,bob@example.com
# POLICY_REQUIRE_EXPIRY=true
# LOOKBACK_DAYS=7
# MAX_EVENTS=100000
# MAX_PAGES_PER_POLL=50
# APPS_REFRESH_MINUTES=15
# Narrow the System Log feed on very large orgs (SCIM filter syntax), e.g.:
# OKTA_LOG_FILTER=eventType sw "application." or eventType eq "user.authentication.sso"

# --- Google Workspace OAuth audit (optional; read only) -----------------------
# Shows which apps people connected to their Google accounts and what access each asked for.
# Leave BOTH empty to keep this feature off. To turn it on, set both (see README, "Google Workspace OAuth"):
#   GOOGLE_SA_KEY      the service account key: the JSON key file's contents, or the same text base64-encoded.
#                      The account needs only the scope https://www.googleapis.com/auth/admin.reports.audit.readonly
#                      through domain-wide delegation. Treat it as a secret.
#   GOOGLE_ADMIN_EMAIL the dedicated admin it acts as (needs only the Reports privilege), e.g. audit-reader@yourdomain.com
GOOGLE_SA_KEY=
GOOGLE_ADMIN_EMAIL=
# GOOGLE_LOOKBACK_DAYS=30
# GOOGLE_POLL_SECONDS=300
# GOOGLE_ACTIVITY_DAYS=3         # how far back to read "used the API" calls (millions on a big org); grants are read for the whole lookback
# GOOGLE_CATCHUP_DELAY_MS=1500   # pause between slices while older history loads
# GOOGLE_REQUEST_DELAY_MS=250    # pause between pages of Google results
