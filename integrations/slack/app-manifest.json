{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Sightline",
    "description": "Location and security alerts from Sightline, posted to the channel you choose.",
    "background_color": "#0f172a"
  },
  "features": {
    "bot_user": {
      "display_name": "Sightline",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
